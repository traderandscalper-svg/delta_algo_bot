# Delta Exchange India DEMO / TESTNET
TRADING_MODE=DEMO
DELTA_REST_URL=https://cdn-ind.testnet.deltaex.org
DELTA_PUBLIC_WS_URL=wss://socket-ind-pub.testnet.deltaex.org
DELTA_PRIVATE_WS_URL=wss://socket-ind.testnet.deltaex.org
DELTA_API_KEY=YOUR_DELTA_API_KEY
DELTA_API_SECRET=YOUR_DELTA_API_SECRET

MAX_RISK_PER_TRADE=0.0025
MAX_LEVERAGE=1
MAX_DAILY_LOSS=0.02
MAX_TRADES_PER_DAY=100
ENABLE_LIVE_TRADING=false

HEARTBEAT_INTERVAL_SECONDS=10
STALE_DATA_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO
LOG_DIRECTORY=logs

# PAPER mode uses real public market data and no private API/IP whitelist.
PAPER_STARTING_EQUITY=10000


# LIVE PRODUCTION TRADING (explicit opt-in; never commit real credentials)
# TRADING_MODE=LIVE
# ENABLE_LIVE_TRADING=true
# DELTA_REST_URL=https://api.india.delta.exchange
# DELTA_PUBLIC_WS_URL=wss://public-socket.india.delta.exchange
# DELTA_PRIVATE_WS_URL=wss://socket.india.delta.exchange
# DELTA_API_KEY=YOUR_PRODUCTION_KEY
# DELTA_API_SECRET=YOUR_PRODUCTION_SECRET
